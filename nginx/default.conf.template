# Billetera MKV — nginx dentro del contenedor.
# La imagen oficial de nginx reemplaza ${NGINX_RESOLVER} al arrancar (solo variables definidas;
# las variables propias de nginx como $uri no se tocan).

# Ruta de S3 tal cual llegó (sin decodificar): si nginx la normaliza, la firma de la URL deja de valer
map $request_uri $s3_global {
    ~^/s3/global(?<ruta>/.*)$ $ruta;
}
map $request_uri $s3_oeste {
    ~^/s3/us-west-2(?<ruta>/.*)$ $ruta;
}

server {
    listen 8095;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    # DNS para resolver S3 (proxy_pass con variables lo necesita)
    resolver ${NGINX_RESOLVER} valid=300s ipv6=off;
    resolver_timeout 5s;

    # ── Proxy de S3 ─────────────────────────────────────────────────
    # El bucket no tiene CORS: el navegador pide los PDFs/imágenes por este mismo dominio.
    # Solo estos dos hosts del bucket mvevipv2 (no es un proxy abierto) y solo lectura.
    location /s3/global/ {
        limit_except GET HEAD { deny all; }
        proxy_pass https://mvevipv2.s3.amazonaws.com$s3_global;
        proxy_set_header Host mvevipv2.s3.amazonaws.com;
        proxy_ssl_server_name on;
        proxy_ssl_name mvevipv2.s3.amazonaws.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
    }

    location /s3/us-west-2/ {
        limit_except GET HEAD { deny all; }
        proxy_pass https://mvevipv2.s3.us-west-2.amazonaws.com$s3_oeste;
        proxy_set_header Host mvevipv2.s3.us-west-2.amazonaws.com;
        proxy_ssl_server_name on;
        proxy_ssl_name mvevipv2.s3.us-west-2.amazonaws.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
    }

    # Cualquier otra zona de /s3/ no existe
    location /s3/ {
        return 404;
    }

    # ── App ─────────────────────────────────────────────────────────
    # Archivos con hash en el nombre: se guardan un año
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # El service worker y el HTML siempre se revisan (así llegan las versiones nuevas)
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        default_type application/manifest+json;
    }

    # SPA: cualquier otra ruta (/inicio, /reserva/10...) es index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
